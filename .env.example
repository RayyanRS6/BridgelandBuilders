# Booking API for the /free-quote form (the functions in /api).
#
# Production: add these in Vercel -> Project -> Settings -> Environment Variables.
# Local: copy this file to .env.local (git-ignored) and fill it in. Without a
# token, `npm run dev` runs the form in mock mode and sends nothing anywhere.
#
# GoHighLevel -> Settings -> Private Integrations -> Create new integration,
# with these scopes: contacts.write, calendars.readonly, calendars/events.write
GHL_API_TOKEN=

# GoHighLevel -> Settings -> Business Profile -> Location ID.
# Bridgeland Builders' location (confirmed against the booking calendar):
GHL_LOCATION_ID=dGbXTzm79MHH01AST3FA

# Optional. Defaults to the "Free 15-Minute Discovery Call" calendar set in
# src/data/quoteForm.js.
# GHL_CALENDAR_ID=
